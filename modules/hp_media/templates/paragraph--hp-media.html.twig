{#
/**
 * @file
 * HP Media paragraph bundle.
 *
 * @ingroup themeable
 */
#}

{%
  set classes = [
    'section--padded-top',
    'section--padded-bottom',
    'media'
  ]
%}

<section{{attributes.addClass(classes).setAttribute('id','hp-'~paragraph.id())}} aria-label="Media">
  {% if hp_show_wrapper %}
    <div class="compartment">
  {% endif %}

      {% if hp_media_type == 'remote_video' %}
        {# Schema.org structured data for Video #}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "VideoObject",
          {% if paragraph.field_hp_md_title.value %}"name": "{{ paragraph.field_hp_md_title.value|striptags }}",{% endif %}
          {% if paragraph.field_hp_md_caption.value %}"description": "{{ paragraph.field_hp_md_caption.value|striptags }}",{% endif %}
          {% if paragraph.field_hp_md_media.entity.field_media_oembed_video.value %}"contentUrl": "{{ paragraph.field_hp_md_media.entity.field_media_oembed_video.value }}",{% endif %}
          {% if paragraph.field_hp_md_media.entity.thumbnail.entity.uri.value %}"thumbnailUrl": "{{ file_url(paragraph.field_hp_md_media.entity.thumbnail.entity.uri.value) }}",{% endif %}
          {% if paragraph.field_hp_md_media.entity.created.value %}"uploadDate": "{{ paragraph.field_hp_md_media.entity.created.value|date('c') }}",{% endif %}
          {% if paragraph.field_hp_md_media.entity.name.value %}"alternateName": "{{ paragraph.field_hp_md_media.entity.name.value|striptags }}",{% endif %}
          {% if url %}"url": "{{ url }}",{% endif %}
          "publisher": {
            "@type": "EducationalOrganization",
            "name": {{ site_name|json_encode|raw }},
            "url": "https://www.howard.edu"
          }
        }
        </script>

        <div class="video">
          {% if content.field_hp_md_title[0] %}
            <div class="block-header">
                <div class="block-header__title">
                    <span class=" block-header__icon icon-picture"></span>
                    <h2>{{ content.field_hp_md_title }}</h2>
                </div>
            </div>
          {% endif %}
          <div class="video__wrap">
            {{ content.field_hp_md_media }}
          </div>
          {% if content.field_hp_md_caption[0] %}
            <div class="video__desc">
              <div class="body-text--light body-text--small media-caption">
                {{ content.field_hp_md_caption }}
              </div>
            </div>
          {% endif %}
        </div>

      {% elseif hp_media_type == 'audio' %}
        {# Schema.org structured data for Audio #}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "AudioObject",
          {% if paragraph.field_hp_md_title.value %}"name": "{{ paragraph.field_hp_md_title.value|striptags }}",{% endif %}
          {% if paragraph.field_hp_md_caption.value %}"description": "{{ paragraph.field_hp_md_caption.value|striptags }}",{% endif %}
          {% if paragraph.field_hp_md_media.entity.field_media_audio_file.entity.uri.value %}"contentUrl": "{{ file_url(paragraph.field_hp_md_media.entity.field_media_audio_file.entity.uri.value) }}",{% endif %}
          {% if paragraph.field_hp_md_media.entity.created.value %}"uploadDate": "{{ paragraph.field_hp_md_media.entity.created.value|date('c') }}",{% endif %}
          {% if paragraph.field_hp_md_media.entity.name.value %}"alternateName": "{{ paragraph.field_hp_md_media.entity.name.value|striptags }}",{% endif %}
          {% if url %}"url": "{{ url }}",{% endif %}
          "publisher": {
            "@type": "EducationalOrganization",
            "name": {{ site_name|json_encode|raw }},
            "url": "https://www.howard.edu"
          }
        }
        </script>

        <div class="audio-file">
          {% if content.field_hp_md_title[0] %}
            <h3>{{ content.field_hp_md_title }}</h3>
          {% endif %}
          {{ content.field_hp_md_media }}
          {% if content.field_hp_md_caption[0] %}
            <div class="body-text--light body-text--small media-caption">
              {{ content.field_hp_md_caption }}
            </div>
          {% endif %}
        </div>

      {% else %}
        {# Schema.org structured data for General Media #}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "MediaObject",
          {% if paragraph.field_hp_md_title.value %}"name": "{{ paragraph.field_hp_md_title.value|striptags }}",{% endif %}
          {% if paragraph.field_hp_md_caption.value %}"description": "{{ paragraph.field_hp_md_caption.value|striptags }}",{% endif %}
          {% if paragraph.field_hp_md_media.entity.field_media_image.entity.uri.value %}"contentUrl": "{{ file_url(paragraph.field_hp_md_media.entity.field_media_image.entity.uri.value) }}",{% endif %}
          {% if paragraph.field_hp_md_media.entity.created.value %}"uploadDate": "{{ paragraph.field_hp_md_media.entity.created.value|date('c') }}",{% endif %}
          {% if paragraph.field_hp_md_media.entity.name.value %}"alternateName": "{{ paragraph.field_hp_md_media.entity.name.value|striptags }}",{% endif %}
          {% if url %}"url": "{{ url }}",{% endif %}
          "publisher": {
            "@type": "EducationalOrganization",
            "name": {{ site_name|json_encode|raw }},
            "url": "https://www.howard.edu"
          }
        }
        </script>

        {% if content.field_hp_md_title[0] %}
          <h3>{{ content.field_hp_md_title }}</h3>
        {% endif %}
        {{ content.field_hp_md_media }}
        {% if content.field_hp_md_caption[0] %}
          <div class="body-text--light body-text--small media-caption">
            {{ content.field_hp_md_caption }}
          </div>
        {% endif %}

      {% endif %}

      <!-- Render without, so quickedit/etc works -->
      {{ content|without('field_hp_md_caption', 'field_hp_md_media', 'field_hp_md_title') }}

  {% if hp_show_wrapper %}
    </div>
  {% endif %}
</section>
