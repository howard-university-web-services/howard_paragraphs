{#
/**
 * @file
 * HP Video Slide Show paragraph bundle.
 *
 * @ingroup themeable
 */
#}

{# Video Slideshow Schema.org structured data #}
{% if paragraph.field_hp_vs_video_slides %}
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "ItemList",
	{% if paragraph.field_hp_vs_title.value %}"name": "{{ paragraph.field_hp_vs_title.value|striptags }}",{% endif %}
	"numberOfItems": {{ paragraph.field_hp_vs_video_slides|length }},
	"itemListElement": [
	{% for key, slide in paragraph.field_hp_vs_video_slides %}
		{% set slide_entity = slide.entity %}
		{
			"@type": "VideoObject",
			"position": {{ key + 1 }}{% if slide_entity.field_hp_vs_title.value %},
			"name": {{ slide_entity.field_hp_vs_title.value|striptags|json_encode|raw }}{% endif %}{% if slide_entity.field_hp_vs_description.value %},
			"description": {{ slide_entity.field_hp_vs_description.value|striptags|json_encode|raw }}{% endif %}
		}{{ not loop.last ? ',' }}
	{% endfor %}
	]
}
</script>
{% endif %}

{%
  set classes = [
    content.field_hp_vs_use_padding[0].value ? 'section--padded-top',
    content.field_hp_vs_use_padding[0].value ? 'section--padded-bottom'
  ]
%}

<section{{attributes.addClass(classes).setAttribute('id','hp-'~paragraph.id())}} aria-label="Video slideshow">
    {# /*Standard Title Rending*/ #}
    {% if content.field_hp_vs_title[0] %}
      <div class="block-header">
          <div class="block-header__title">
              <span class="block-header__icon icon-picture"></span>
              <h2>{{ content.field_hp_vs_title }}</h2>
          </div>
      </div>
    {% endif %}

    {# /*Render Video Container and Navigation*/ #}
    <div class="hp_video_slideshow--slideshow-wrapper">
      <div class="hp_video_slideshow--slideshow" style="background-image: url('{{ hp_vs_fallback_img_url }}')">
        {{ content.field_hp_vs_video_slides }}
      </div>
      <div class="hp_video_slideshow--slideshow-nav"></div>
    </div>
</section>
