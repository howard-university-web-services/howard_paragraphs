{#
/**
 * @file
 * HP Graph paragraph.
 *
 * @ingroup themeable
 */
#}

{# Graph Schema.org structured data as Dataset #}
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "Dataset"{% if paragraph.field_hp_graph_title.value %},
	"name": {{ paragraph.field_hp_graph_title.value|striptags|json_encode|raw }}{% endif %}{% if paragraph.field_hp_graph_description.value %},
	"description": {{ paragraph.field_hp_graph_description.value|striptags|json_encode|raw }}{% endif %},
	"publisher": {
		"@type": "EducationalOrganization",
		"name": "Howard University"
	}{% if paragraph.field_hp_graph_data %},
	"distribution": [
	{% for key, data in paragraph.field_hp_graph_data %}
		{% set data_entity = data.entity %}
		{
			"@type": "DataDownload"{% if data_entity.field_hp_graph_label.value %},
			"name": {{ data_entity.field_hp_graph_label.value|striptags|json_encode|raw }}{% endif %}{% if data_entity.field_hp_graph_value.value %},
			"contentSize": "{{ data_entity.field_hp_graph_value.value }}"{% endif %}
		}{{ not loop.last ? ',' }}
	{% endfor %}
	]{% endif %}
}
</script>

{%
  set classes = [
    'section--padded-top',
    'section--padded-bottom'
  ]
%}

<section{{attributes.addClass(classes).setAttribute('id','hp-'~paragraph.id())}} aria-label="Graph">
	{% if hp_show_wrapper %}
		<section class="compartment">
		{% endif %}
		<div class="hp_graph_bundle">
			<div class="text col">
				<div class="text_wrapper">
					{%  if true in content.field_hp_graph_title[0] %}
						<h2 class="lead-in">{{ content.field_hp_graph_title[0] }}</h2>
					{% endif %}
					{%  if true in content.field_hp_graph_description[0] %}
						<p>{{ content.field_hp_graph_description[0] }}</p>
					{% endif %}
				</div>
			</div>
			<div class="graph col">
				{% for i in 0..content.field_hp_graph_data|length %}
					{% if content.field_hp_graph_data[i] is not null %}
						{{ content.field_hp_graph_data[i] }}
					{% endif %}
				{% endfor %}
			</div>
			{%  if true in content.field_hp_graph_link[0] %}
				<div class="hyperlink">
					<a href="{% apply spaceless %}{{-content.field_hp_graph_link[0]['#url']-}}{% endapply %}" class="btn">
						<span class="btn__text">{{ content.field_hp_graph_link[0]['#title'] }}</span>
						<span class="icon-arrow-right"></span>
					</a>
				</div>
			{% endif %}
		</div>
		{% if hp_show_wrapper %}
		</section>
	{% endif %}
</section>
