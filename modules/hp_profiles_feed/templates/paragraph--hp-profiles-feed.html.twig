{#
/**
 * @file
 * HP Profiles Feed paragraph bundle.
 *
 * @ingroup themeable
 */
#}

{%
  set classes = [
    'section--padded-top',
    'section--padded-bottom'
  ]
%}

<section{{attributes.addClass(classes).setAttribute('id','hp-'~paragraph.id())}} aria-label="Howard profiles">
	{% if hp_show_wrapper %}
		<div class="compartment">
		{% endif %}

		{% if content.field_hp_pf_title[0] %}
			<div class="block-header">
				<div class="block-header__title">
					<span class=" block-header__icon icon-our-people"></span>
					<h2>{{ content.field_hp_pf_title }}</h2>
				</div>
			</div>
		{% endif %}

		{% if content.field_hp_pf_descriptive_text[0] %}
			<div class="block-header__description">{{ content.field_hp_pf_descriptive_text }}</div>
		{% endif %}

		<div class="silc-grid">

			{% for prsn in hp_pf_profiles.data %}
				{# Schema.org structured data for Person #}
				<script type="application/ld+json">
				{
					"@context": "https://schema.org",
					"@type": "Person",
					"name": "{{ prsn.full_name|striptags }}",
					{% if prsn.affiliation.title %}"jobTitle": "{{ prsn.affiliation.title|striptags }}",{% endif %}
					{% if prsn.affiliation.department %}
					"worksFor": {
						"@type": "Organization",
						"name": "{{ prsn.affiliation.department|striptags }}",
						"parentOrganization": {
							"@type": "EducationalOrganization",
							"name": "Howard University"
						}
					},
					{% endif %}
					{% if prsn.featured_image.image_styles.hc_large_480_480_cropped %}"image": "{{ prsn.featured_image.image_styles.hc_large_480_480_cropped }}",{% endif %}
					{% if prsn.show_email and prsn.email %}"email": "{{ prsn.email }}",{% endif %}
					"url": "{{ hp_pf_env_url }}{{ prsn.url }}"
				}
				</script>

				<div class="silc-grid__col silc-grid__col--4-medium">
					<div class="faculty-profile">
						<div class="faculty-profile__block">
							<div class="faculty-profile__img">
								{% if prsn.featured_image.image_styles.hc_large_480_480_cropped %}
									<img src="{{ prsn.featured_image.image_styles.hc_large_480_480_cropped }}" alt="Profile headshot photo of {{ prsn.full_name }}."/>
								{% else %}
									<img src="https://profiles.howard.edu/sites/profiles.howard.edu/themes/custom/hu_profiles_theme/idfive-component-library/src/img/howard_avatar.jpg" alt="Avatar of grey silouette, used to when no person photo exists."/>
								{% endif %}
							</div>
							<h3>{{ prsn.full_name }}</h3>
							{% if prsn.pronoun %}
								<h5>
									<em>{{prsn.pronoun}}</em>
								</h5>
							{% endif %}
							{% if prsn.affiliation.title %}
								<h4>{{ prsn.affiliation.title }}</h4>
							{% endif %}
							<h5>{{ prsn.affiliation.department }}</h5>
							<div class="faculty-profile__divider"></div>
							{% if prsn.show_email %}
								<a href="mailto:{{ prsn.email }}" class=" faculty-profile__link faculty-profile__email">
									<span class="icon icon-envelope"></span>
									{{ prsn.email }}</a>
							{% endif %}
						</div>
						<div class="faculty-profile__btn">
							<a href="{{ hp_pf_env_url }}{{ prsn.url }}" class="fancy-link fancy-link--dark" target="_blank">
								<span>View Full Profile<span class="visually-hidden">
										of
										{{ prsn.full_name }}</span>
								</span>
								<span class="icon-arrow-right"></span>
							</a>
						</div>
					</div>
				</div>
			{% endfor %}

		</div>
		{% if hp_show_wrapper %}
		</div>
	{% endif %}
</section>
