{#
/**
 * @file
 * IP Timeline paragraph bundle.
 *
 * @ingroup themeable
 */
#}

{# Timeline Schema.org structured data #}
{% if paragraph.field_hp_timeline_field %}
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "ItemList"{% if paragraph.field_hp_timeline_title.value %},
	"name": {{ paragraph.field_hp_timeline_title.value|striptags|json_encode|raw }}{% endif %}{% if paragraph.field_hp_timeline_text.value %},
	"description": {{ paragraph.field_hp_timeline_text.value|striptags|json_encode|raw }}{% endif %},
	"numberOfItems": {{ paragraph.field_hp_timeline_field|length }},
	"itemListElement": [
	{% for key, item in paragraph.field_hp_timeline_field %}
		{% set item_entity = item.entity %}
		{
			"@type": "Event",
			"position": {{ key + 1 }}{% if item_entity.field_hp_timeline_field_title.value %},
			"name": {{ item_entity.field_hp_timeline_field_title.value|striptags|json_encode|raw }}{% endif %}{% if item_entity.field_hp_timeline_field_datetime.value %},
			"startDate": "{{ item_entity.field_hp_timeline_field_datetime.value|date('c') }}"{% endif %}{% if item_entity.field_hp_timeline_field_desc.value %},
			"description": {{ item_entity.field_hp_timeline_field_desc.value|striptags|json_encode|raw }}{% endif %}
		}{{ not loop.last ? ',' }}
	{% endfor %}
	],
	"publisher": {
		"@type": "EducationalOrganization",
		"name": "Howard University"
	}
}
</script>
{% endif %}

{%
  set classes = [
    'section--padded-top',
    'section--padded-bottom'
  ]
%}

<section{{attributes.addClass(classes).setAttribute('id','hp-'~paragraph.id())}} aria-label="Timeline">
    {% if hp_show_wrapper %}
        <section class="compartment">
    {% endif %}
            <div>
                {% if content.field_hp_timeline_title is not null %}
                    <h2 class="lead-in">{{ content.field_hp_timeline_title }}</h2>
                {% endif %}
                {% if content.field_hp_timeline_text is not null %}
                    <p>{{ content.field_hp_timeline_text }}</p>
                {% endif %}
            </div>
            <div class="timeline">
                {{ content.field_hp_timeline_field }}
            </div>
    {% if hp_show_wrapper %}
        </section>
    {% endif %}
</section>
