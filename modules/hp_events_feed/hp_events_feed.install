<?php

/**
 * @file
 * Update hooks for the Howard Localist Events Feed.
 */

use Drupal\field\Entity\FieldStorageConfig;

/**
 * Add the text-card layout to already installed event paragraphs.
 */
function hp_events_feed_update_8001() {
  $storage = FieldStorageConfig::loadByName('paragraph', 'field_hp_ef_layout');
  if ($storage === NULL) {
    return;
  }
  $values = $storage->getSetting('allowed_values');
  $allowed = [];
  foreach ($values as $value => $label) {
    $allowed[$value] = $value === 'cards' && $label === 'Cards with images' ? 'Image cards (4 columns)' : $label;
    if ($value === 'cards' && !isset($values['text_cards'])) {
      $allowed['text_cards'] = 'Text cards (3 columns)';
    }
  }
  $allowed += ['text_cards' => 'Text cards (3 columns)'];
  $storage->setSetting('allowed_values', $allowed)->save();
}

/**
 * Hide the legacy pager control and update event-count wording.
 */
function hp_events_feed_update_8003() {
  $displays = \Drupal::entityTypeManager()->getStorage('entity_form_display')->loadByProperties([
    'targetEntityType' => 'paragraph',
    'bundle' => 'hp_events_feed',
  ]);
  foreach ($displays as $display) {
    $display->removeComponent('field_hp_ef_pager')->save();
  }

  $pager = \Drupal\field\Entity\FieldConfig::loadByName('paragraph', 'hp_events_feed', 'field_hp_ef_pager');
  if ($pager) {
    $pager->setDefaultValue([['value' => 0]])
      ->setDescription('Legacy pagination setting; pagination is disabled.')
      ->save();
  }

  $count = \Drupal\field\Entity\FieldConfig::loadByName('paragraph', 'hp_events_feed', 'field_hp_ef_count');
  if ($count && $count->label() === 'Events per page') {
    $count->setLabel('Number of events')->save();
  }

  return t('Pagination is disabled and its editor control has been hidden.');
}
