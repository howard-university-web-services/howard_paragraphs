{#
/**
 * @file
 * HP Carousel with Caption Slide paragraph bundle.
 *
 * @ingroup themeable
 */
#}

<div class="slideshow__single">
  <div class="slideshow__img"><img src="{{ hp_cc_image }}" alt="{{ hp_cc_image_alt }}"></div>
  <div class="slideshow__desc">
    {% if content.field_hp_cc_title|render %}
      <h2>{{ content.field_hp_cc_title }}</h2>
    {% endif %}
    {{ content.field_hp_cc_text }}
    {{ content.field_hp_cc_link }}
  </div>
</div>
