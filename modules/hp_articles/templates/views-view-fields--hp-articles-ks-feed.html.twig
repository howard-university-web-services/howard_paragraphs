{#
/**
* @file
* Theme override for feed of articles.
*
* @see template_preprocess_views_view_fields()
*/
#}

<div class="silc-grid__col silc-grid__col--4-medium">
	{# Schema.org structured data for Article #}
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "Article",
		"headline": {{ fields.title.content|render|striptags|json_encode|raw }},
		{% if fields.field_hc_article_type.content == 'External Article' -%}
		{% if fields.field_hc_article_link.content -%}
		"url": {{ fields.field_hc_article_link.content|render|striptags|json_encode|raw }},
		{%- endif %}
		{% if fields.field_hc_article_dateline.content -%}
		"datePublished": {{ fields.field_hc_article_dateline.content|render|striptags|json_encode|raw }},
		{%- endif %}
		{% if fields.field_hc_article_source.content -%}
		"publisher": {
			"@type": "Organization",
			"name": {{ site_name|json_encode|raw }}
		},
		{%- endif %}
		{%- else -%}
		"url": "{{ path('entity.node.canonical', {'node': fields.nid.content|render|striptags|trim}) }}",
		{% if fields.created.content -%}
		"datePublished": {{ fields.created.content|render|striptags|json_encode|raw }},
		{%- endif %}
		{% if fields.body.content -%}
		"description": {{ fields.body.content|render|striptags|json_encode|raw }},
		{%- endif %}
		"publisher": {
			"@type": "EducationalOrganization",
			"name": {{ site_name|json_encode|raw }}
		},
		{%- endif %}
		{% if fields.field_hc_article_category.content -%}
		"about": {{ fields.field_hc_article_category.content|render|striptags|json_encode|raw }}
		{%- else -%}
		"about": "News"
		{%- endif %}
	}
	</script>
	{% if fields.field_hc_article_type.content == 'External Article' %}
		<a href="{{ fields.field_hc_article_link.content }}" class="news-and-events__block" target="_blank">
			<div class="news-and-events__desc">
				<span class="news-and-events__date">{{ fields.field_hc_article_dateline.content }}</span>
				<h3 class="news-and-events__title header--h3-small">{{ fields.title.content }}</h3>
				{% if fields.field_hc_article_source.content %}
					<p class="body-text--small">
						<strong>Source:
						</strong>
						{{ fields.field_hc_article_source.content }}
					</p>
				{% endif %}
				{% if fields.field_hc_article_category.content %}
					<p class="body-text--small">
						<strong>Category:
						</strong>
						{{ fields.field_hc_article_category.content }}
					</p>
				{% endif %}
			</div>
		</a>
	{% else %}
		<a href="{{ path('entity.node.canonical', {'node': fields.nid.content|render|striptags|trim}) }}" class="news-and-events__block">
			{% if fields.field_media_image.content|render|striptags %}
				<div class="news-and-events__img">{{fields.field_media_image.content }}</div>
			{% endif %}
			<div class="news-and-events__desc">
				<span class="news-and-events__date">{{ fields.created.content }}</span>
				<h3 class="news-and-events__title header--h3-small">{{ fields.title.content }}</h3>
				<p class="body-text--small">{{ fields.body.content }}</p>
				{% if fields.field_hc_article_category.content %}
					<p class="body-text--small">
						<strong>Category:</strong>
						{{ fields.field_hc_article_category.content }}
					</p>
				{% endif %}
			</div>
		</a>
	{% endif %}
</div>
