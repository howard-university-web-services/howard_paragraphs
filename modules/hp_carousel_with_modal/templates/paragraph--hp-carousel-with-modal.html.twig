{#
/**
 * @file
 * HP Carousel with Modal paragraph bundle.
 *
 * @ingroup themeable
 */
#}

{# Modal Carousel Schema.org structured data with image details #}
{% if paragraph.field_hp_cm_slides %}
<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "ItemList",
	{% if paragraph.field_hp_cm_title.value %}"name": "{{ paragraph.field_hp_cm_title.value|striptags }}",{% endif %}
	"numberOfItems": {{ paragraph.field_hp_cm_slides|length }},
	"itemListElement": [
	{% for key, slide in paragraph.field_hp_cm_slides %}
		{% set slide_entity = slide.entity %}
		{
			"@type": "ImageObject",
			"position": {{ key + 1 }},
			{% if slide_entity.field_hp_cm_image.entity.field_media_image.entity %}
			"url": {{ file_url(slide_entity.field_hp_cm_image.entity.field_media_image.entity.fileuri)|json_encode|raw }},
			{% if slide_entity.field_hp_cm_image.entity.field_media_image.alt %}
			"caption": {{ slide_entity.field_hp_cm_image.entity.field_media_image.alt|json_encode|raw }},
			{% endif %}
			{% endif %}
			{% if slide_entity.field_hp_cm_title.value %}
			"name": {{ slide_entity.field_hp_cm_title.value|striptags|json_encode|raw }}
			{% endif %}
		}{{ not loop.last ? ',' }}
	{% endfor %}
	],
	"publisher": {
		"@type": "EducationalOrganization",
		"name": "Howard University"
	}
}
</script>
{% endif %}

{%
  set classes = [
    'section--padded-top',
    'section--padded-bottom'
  ]
%}

<section{{attributes.addClass(classes).setAttribute('id','hp-'~paragraph.id())}} aria-label="Carousel with modal">
  {% if hp_show_wrapper %}
    <div class="compartment">
  {% endif %}

      {% if content.field_hp_cm_title[0] %}
        <div class="block-header">
            <div class="block-header__title">
                <span class=" block-header__icon icon-picture"></span>
                <h2>{{ content.field_hp_cm_title }}</h2>
            </div>
        </div>
      {% endif %}

      <div class="carousel">

        {{ content.field_hp_cm_slides }}

      </div>

      <!-- Render without, so quickedit/etc works -->
      {{ content|without('field_hp_cm_slides', 'field_hp_cm_title') }}

  {% if hp_show_wrapper %}
    </div>
  {% endif %}
</section>
